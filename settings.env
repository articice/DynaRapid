# This will give the location of all the directories and source files. 
# Have all / as required. The code does not add it   
# all lines to be commented starts with # 
# Tag and location to be separated by :<single space>
#
Export License: export XILINXD_LICENSE_FILE=
Source Vivado: source /home/user/Xilinx/Vivado/2022.1/settings64.sh
Source RapidWright: source /home/user/RapidWright/tcl/rapidwright.tcl
Map: /home/user/RapidWright/DynaRapid/map/
Pre-synthDCPs: /home/user/RapidWright/DynaRapid/library/preSynthDCPs/
GenericSynthDCPs: /home/user/RapidWright/DynaRapid/library/genericSynthDCPs/
VHDLSynthDCPs: /home/user/RapidWright/DynaRapid/library/vhdlSynthDCPs/
Pre-exposedDCPs: /home/user/RapidWright/DynaRapid/library/pre-exposedDCPs/
ExposedDCPs: /home/user/RapidWright/DynaRapid/exposedDCPs/
PlacedRoutedDCPs: /home/user/RapidWright/DynaRapid/library/placedRoutedDCPs/
VivadoRun: /home/user/RapidWright/DynaRapid/vivadoRun/
DotFiles: /home/user/RapidWright/DynaRapid/dotFiles/
Designs: /home/user/RapidWright/DynaRapid/designs/
SrcVHDLFiles: /home/user/RapidWright/DynaRapid/library/vhdlFiles/
